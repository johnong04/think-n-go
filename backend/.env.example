AWS_REGION="ap-southeast-1"
AWS_PROFILE="finhack_IsbUsersPS-560288546574"
AWS_BEDROCK_REGION="ap-southeast-1"
BEDROCK_MODEL_ID="apac.amazon.nova-micro-v1:0"

# Alibaba Cloud Configuration
ALIBABA_ACCESS_KEY_ID=your_access_key_id
ALIBABA_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_REGION=cn-hangzhou

# OSS Configuration (Object Storage Service)
ALIBABA_OSS_BUCKET=your_bucket_name
ALIBABA_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# ─── AWS RDS PostgreSQL (Contract & Escrow Service) ─────────────────────────
# Connection Details
DB_HOST=tngo-db.cr4gye8ic94o.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_rds_password

# SSL Configuration for RDS
DB_SSL_MODE=verify-full
DB_SSL_ROOT_CERT=./global-bundle.pem

# AWS Secrets Manager (for password retrieval)
# Optional: when DB_PASSWORD is empty/placeholder, app/db/database.py will
# fetch password from this secret automatically via boto3.
AWS_SECRETS_MANAGER_SECRET_ARN=
# AWS_SECRETS_MANAGER_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:560288546574:secret:rds!db-2b05fd4c-a61f-4ae7-aa35-e459bac66a47-7ZByWW
# Use: aws secretsmanager get-secret-value --secret-id '<SECRET_ARN>' --query SecretString --output text | jq -r '.password'
